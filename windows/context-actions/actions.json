{
  "file_types": {
    ".gif": [
      { "label": "convert gif to mp4",  "args": ["convert", "gif2mp4"] },
      { "label": "convert gif to webm", "args": ["convert", "gif2webm"] }
    ],
    ".png": [
      { "label": "convert to jpg", "args": ["convert", "img2jpg"] }
    ],
    ".webp": [
      { "label": "convert to jpg", "args": ["convert", "img2jpg"] }
    ],
    ".jpeg": [
      { "label": "convert to jpg", "args": ["convert", "img2jpg"] }
    ],
    ".jpg": [
      { "label": "scale image", "children": [
        { "label": "by 1",    "args": ["scale", "1"] },
        { "label": "by 1.5",  "args": ["scale", "1.5"] },
        { "label": "by 2",    "args": ["scale", "2"] },
        { "label": "by 3",    "args": ["scale", "3"] },
        { "label": "by 4",    "args": ["scale", "4"] },
        { "label": "more...", "args": ["scale", "more"] }
      ] }
    ],
    ".rpgmvp": [
      { "label": "convert rpgmvp to png", "args": ["convert", "rpgmvp2png"] }
    ],
    ".png_": [
      { "label": "convert png_ to png", "args": ["convert", "rpgmvp2png"] }
    ],
    ".zip": [
      { "label": "unzip (JP/Shift-JIS)", "args": ["unzip-jp"] }
    ],
    ".7z": [
      { "label": "unzip", "args": ["unzip-7z"] }
    ],
    ".001": [
      { "label": "unzip (7z multi-volume)", "args": ["unzip-7z"] }
    ],
    "Directory": [
      { "label": "move files one folder up",          "args": ["mv-up"] },
      { "label": "move files one folder up renumber", "args": ["mv-up-renum"] },
      { "label": "rename *_large extensions",         "args": ["rename-large"] },
      { "label": "convert all rpgmvp to png",         "args": ["convert", "rpgmvp2png"] },
      { "label": "file count by extension",           "args": ["ext-stats"] }
    ],
    "Directory\\Background": [
      { "label": "convert all png/webp/jpeg to jpg",      "args": ["convert", "img2jpg"] },
      { "label": "convert all gif to mp4",                "args": ["convert", "gif2mp4"] },
      { "label": "rename files with special chars",       "args": ["rename-special"] },
      { "label": "move all files one folder up",          "args": ["mv-up"] },
      { "label": "move all files one folder up renumber", "args": ["mv-up-renum"] },
      { "label": "unzip all zip/rar/7z recursively",      "args": ["unzip-all"] },
      { "label": "rename *_large extensions",             "args": ["rename-large"] },
      { "label": "convert all rpgmvp to png",             "args": ["convert", "rpgmvp2png"] },
      { "label": "move videos to video/ folder",          "args": ["move-videos"] },
      { "label": "translate jp to zh",                    "args": ["rpgmv-trans"] },
      { "label": "render rpg interactive map",            "args": ["rpgview-render"] },
      { "label": "file count by extension",               "args": ["ext-stats"] },
      { "label": "scale all jpg", "children": [
        { "label": "by 2",    "args": ["scale", "2"] },
        { "label": "more...", "args": ["scale", "more"] }
      ] }
    ]
